# Copy to backend/.env (loaded automatically by settings.py) or set these in your shell.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_TIME_ZONE=Asia/Manila
# Supabase: Connect > Session pooler. Leave empty to use local SQLite.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase Storage (Storage > Settings > S3 Connection). Leave the access key empty to store uploads in backend/media/.
SUPABASE_PROJECT_REF=
SUPABASE_REGION=
SUPABASE_BUCKET=media
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
